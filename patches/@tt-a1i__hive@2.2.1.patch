+import { createHash } from 'node:crypto';
+import { controllerReceiptPendingSql } from './controller-receipt-policy.js';
+import { dispatchMessageEligibilitySql } from './dispatch-message-delivery-policy.js';
+
+const fault = (code, message, cause) => Object.assign(new Error(message, cause ? {cause} : undefined), {code});
+const identity = value => typeof value === 'string' && value.length > 0 && value.length <= 1024 && !/[\x00-\x1f\x7f]/.test(value);
+/** Authoritative ledger facts only. Delivery acknowledgement can mean desktop
+ * enqueue; callers must separately check their durable spool/native receipts.
+ * Does not invoke store getters that initialize rows or any drain/notification. */
+export const createDesktopConversationSwitchState = (db, isClosing) => (workspaceId, agentId) => {
+    if (!identity(workspaceId) || agentId !== undefined && !identity(agentId))
+        throw fault('DESKTOP_SWITCH_INVALID_ARGUMENT', 'Supply a workspace identity and optional agent identity');
+    const read = () => {
+        const bindings = {workspace: workspaceId, agent: agentId ?? null};
+        const parameters = sql => sql.includes('$agent') ? bindings : {workspace: workspaceId};
+        const row = sql => db.prepare(sql).get(parameters(sql));
+        const count = sql => {
+            const n = row(sql)?.n;
+            if (!Number.isSafeInteger(n) || n < 0) throw fault('DESKTOP_SWITCH_CORRUPT', 'Responsibility counts could not be verified');
+            return n;
+        };
+        const workspace = row('SELECT id,controller_mode FROM workspaces WHERE id=$workspace');
+        if (!workspace) throw fault('DESKTOP_SWITCH_WORKSPACE_UNKNOWN', 'Workspace does not exist');
+        if (!['internal', 'codex_app'].includes(workspace.controller_mode)) throw fault('DESKTOP_SWITCH_CORRUPT', 'Workspace controller mode is unsupported');
+        if (agentId !== undefined && agentId !== `${workspaceId}:orchestrator` && agentId !== `${workspaceId}:__workflow__`
+            && !row('SELECT id FROM workers WHERE workspace_id=$workspace AND id=$agent'))
+            throw fault('DESKTOP_SWITCH_AGENT_UNKNOWN', 'Agent does not exist in this workspace');
+        const dispatchScope = '($agent IS NULL OR d.from_agent_id=$agent OR d.to_agent_id=$agent)';
+        const messageScope = '($agent IS NULL OR m.from_agent_id=$agent OR m.recipient_agent_id=$agent)';
+        const reportScope = `($agent IS NULL OR o.target_agent_id=$agent OR d.from_agent_id=$agent OR d.to_agent_id=$agent)`;
+        const reports = 'FROM report_outbox o LEFT JOIN dispatches d ON d.workspace_id=o.workspace_id AND d.id=COALESCE(o.source_dispatch_id,o.dispatch_id)';
+        const openDispatches = {
+            queued: count(`SELECT COUNT(*) n FROM dispatches d WHERE d.workspace_id=$workspace AND d.status='queued' AND ${dispatchScope}`),
+            submitted: count(`SELECT COUNT(*) n FROM dispatches d WHERE d.workspace_id=$workspace AND d.status='submitted' AND ${dispatchScope}`),
+        };
+        const pendingReports = count(`SELECT COUNT(*) n ${reports} WHERE o.workspace_id=$workspace AND ${reportScope} AND ${controllerReceiptPendingSql}`);
+        const pendingDispatchMessages = {};
+        for (const state of ['queued', 'delivering']) pendingDispatchMessages[state] = count(`SELECT COUNT(*) n FROM dispatch_message_outbox o
+            JOIN dispatch_messages m ON m.id=o.message_id WHERE m.workspace_id=$workspace AND o.state='${state}' AND ${messageScope}`);
+        const pendingQuestions = count(`SELECT COUNT(*) n FROM dispatch_messages m LEFT JOIN dispatch_message_outbox o ON o.message_id=m.id
+            WHERE m.workspace_id=$workspace AND ${messageScope} AND m.kind='question' AND COALESCE(o.state,'recorded')!='cancelled'
+            AND ${dispatchMessageEligibilitySql} AND NOT EXISTS (SELECT 1 FROM dispatch_messages answer WHERE answer.workspace_id=m.workspace_id AND answer.reply_to=m.id AND answer.kind='answer')`);
+        const controllerReceipts = workspace.controller_mode === 'codex_app'
+            ? count(`SELECT COUNT(*) n ${reports} WHERE o.workspace_id=$workspace AND o.target_agent_id=o.workspace_id||':orchestrator' AND ${reportScope} AND ${controllerReceiptPendingSql}`) : 0;
+        // Connection and operation facts affect workspace-wide routing even when
+        // dispatch/message responsibilities are filtered to a particular agent.
+        const controller = {
+            pendingConnection: count('SELECT COUNT(*) n FROM workspace_controllers WHERE workspace_id=$workspace AND (request_id IS NOT NULL OR request_thread_id IS NOT NULL)') > 0,
+            pendingOperations: count("SELECT COUNT(*) n FROM controller_operations WHERE workspace_id=$workspace AND state='pending'"),
+            unknownOperations: count("SELECT COUNT(*) n FROM controller_operations WHERE workspace_id=$workspace AND state='unknown'"),
+            sendingNotifications: count("SELECT COUNT(*) n FROM report_outbox WHERE workspace_id=$workspace AND notification_state='sending'"),
+            unreadReceipts: workspace.controller_mode === 'codex_app' ? count(`SELECT COUNT(*) n ${reports} WHERE o.workspace_id=$workspace AND o.target_agent_id=o.workspace_id||':orchestrator' AND o.read_at IS NULL AND ${reportScope} AND ${controllerReceiptPendingSql}`) : 0,
+            readUnacknowledgedReceipts: workspace.controller_mode === 'codex_app' ? count(`SELECT COUNT(*) n ${reports} WHERE o.workspace_id=$workspace AND o.target_agent_id=o.workspace_id||':orchestrator' AND o.read_at IS NOT NULL AND ${reportScope} AND ${controllerReceiptPendingSql}`) : 0,
+        };
+        const hash = createHash('sha256').update('desktop-conversation-switch-state:v1');
+        hash.update(JSON.stringify([workspaceId, agentId ?? null]));
+        // Fixed, non-secret business tables only; never settings/auth/token tables.
+        for (const table of ['messages', 'dispatches', 'dispatch_messages', 'dispatch_message_outbox', 'report_outbox', 'workspace_controllers', 'controller_operations']) {
+            hash.update(table);
+            const sql = table === 'dispatch_message_outbox'
+                ? 'SELECT o.* FROM dispatch_message_outbox o JOIN dispatch_messages m ON m.id=o.message_id WHERE m.workspace_id=$workspace ORDER BY o.rowid'
+                : table === 'controller_operations'
+                    ? 'SELECT workspace_id,operation_id,thread_id,state FROM controller_operations WHERE workspace_id=$workspace ORDER BY rowid'
+                    : `SELECT * FROM ${table} WHERE workspace_id=$workspace ORDER BY rowid`;
