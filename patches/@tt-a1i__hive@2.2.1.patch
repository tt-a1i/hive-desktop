+                    || table === 'dispatch_message_outbox' && !['queued','delivering','delivered','cancelled'].includes(value.state)
+                    || table === 'controller_operations' && !['pending','unknown','completed','failed'].includes(value.state)
+                    || ['report_outbox','dispatch_message_outbox'].includes(table) && value.delivered_at !== null && (!Number.isSafeInteger(value.delivered_at) || value.delivered_at < 0))
+                    throw fault('DESKTOP_SWITCH_CORRUPT', 'Responsibility state contains an unsupported ledger value');
+                hash.update(JSON.stringify(value));
+            }
+        }
+        hash.update(JSON.stringify(workspace));
+        for (const worker of db.prepare('SELECT id,workspace_id FROM workers WHERE workspace_id=$workspace ORDER BY id').iterate({workspace: workspaceId})) hash.update(JSON.stringify(worker));
+        const blockers = [];
+        const block = (code, n) => { if (n) blockers.push({code, count:n}); };
+        block('OPEN_DISPATCHES', openDispatches.queued + openDispatches.submitted);
+        block('PENDING_REPORTS', pendingReports);
+        block('PENDING_DISPATCH_MESSAGES', pendingDispatchMessages.queued + pendingDispatchMessages.delivering);
+        block('UNANSWERED_QUESTIONS', pendingQuestions);
+        block('CONTROLLER_RECEIPTS', controllerReceipts);
